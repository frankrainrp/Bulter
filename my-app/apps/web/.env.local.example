# Local single-user development. Copy to .env.local; never commit real secrets.
DEEPSEEK_API_KEY=ollama
DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
DEEPSEEK_MODEL=qwen3:0.6b
OLLAMA_SERVER_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_SERVER_MODEL=qwen3:0.6b
# Optional alternate route; leave empty to use only the primary route.
OLLAMA_WINDOWS_BASE_URL=
OLLAMA_WINDOWS_MODEL=
BUTLER_DB_PATH=./data/butler.sqlite
# Optional paid OCR provider. No key is bundled.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OCR_PROVIDER=mistral
