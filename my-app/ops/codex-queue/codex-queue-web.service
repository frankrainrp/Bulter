[Unit]
Description=Ubuntu Codex multi-project task queue web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frankrain
Group=frankrain
Environment=HOME=/home/frankrain
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/frankrain/server/apps/codex-queue/codex_queue.py --db /home/frankrain/server/data/codex-queue/queue.sqlite serve --host 0.0.0.0 --port 3765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/frankrain/server/data/codex-queue

[Install]
WantedBy=multi-user.target
