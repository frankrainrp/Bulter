[Unit]
Description=Deploy the latest CI-approved Butler release
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=frankrain
Group=frankrain
ExecStart=/home/frankrain/server/bin/butler-auto-deploy
Nice=10

[Install]
WantedBy=multi-user.target
