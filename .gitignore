# ============================================================
# Butler — repository ignore rules
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Local environment and credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turborepo
.turbo/

# TypeScript incremental build
*.tsbuildinfo

# Local Python/SQLite smoke-test artifacts
__pycache__/
*.py[cod]
.tmp-queue.sqlite*

# Local distribution and MCP verification state
my-app/apps/web/data/
butler-mcp/data/
butler-mcp/scripts/smoke-vault.json
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Workstation-specific agent permissions
.claude/settings.local.json
